# ==============================================================
#  BOT DE TRADE ETH — variáveis de ambiente
#  No Coolify, configure estas variáveis no painel (Environment
#  Variables). NÃO comite o .env real no git.
# ==============================================================

# --- Binance: API REST ---
# Base da API REST da Binance (produção). Ex: https://api.binance.com/api
API_URL_PROD=https://api.binance.com/api

# WebSocket de streams da Binance (produção).
# Ex: wss://stream.binance.com:9443/ws
STREAM_URL_PROD=wss://stream.binance.com:9443/ws

# Par negociado (ex: SOLUSDT, ETHUSDT).
SYMBOL=SOLUSDT

# --- Binance: CHAVES (SOMENTE aqui, nunca via Telegram) ---
# Crie a API key na Binance com permissão APENAS de "Spot Trading"
# (sem saque) e, de preferência, com restrição de IP do servidor.
API_KEY_PROD=
SECRET_KEY_PROD=

# --- Telegram ---
# Token do bot (obtido no @BotFather).
BOT_TOKEN=
# ID do chat/grupo autorizado. Somente este chat pode usar os comandos.
# Se for GRUPO/supergrupo, o ID normalmente é NEGATIVO (ex: -1002567919075).
CHAT_ID=

# --- CoinMarketCap ---
# A chave do CoinMarketCap NÃO fica no .env: é configurada em tempo de
# execução via comando /set_cmc_key no Telegram (fica salva no banco).

# --- Banco de dados (SQLite) ---
# Em produção (Docker/Coolify) o banco deve ficar num VOLUME persistente.
# O Dockerfile já define file:/data/crypto.db; configure Persistent Storage
# apontando para /data no Coolify.
# Em desenvolvimento local, use algo como file:./crypto.db
DATABASE_URL=file:/data/crypto.db
