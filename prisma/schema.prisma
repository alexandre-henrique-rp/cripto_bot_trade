generator client {
  provider      = "prisma-client-js"
  // native = ambiente local; debian-openssl-3.0.x = imagem node:22-slim (bookworm) no container.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Wallet {
  id          String    @id @default(cuid())
  symbol      String?
  price       Float?
  quantity    String?
  usd         Float?
  sellPrice   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model sales {
  id          String    @id @default(cuid())
  symbol      String?
  lucro       String?
  valor_recebido String?
  valor_investido String?
  quantidade String?
  price_compra String?
  price_venda String?
  createdAt   DateTime  @default(now())
}
  
model config{
  id          String    @id @default(cuid())
  symbol      String?
  taxa_min    Float?
  // --- Estratégia de reversão (configurável via Telegram) ---
  reversal_percent      Float?   @default(5)      // % de reversão para disparar compra/venda
  auto_reversal         Boolean  @default(false)  // liga/desliga ajuste automático do reversal
  // --- Coleta CoinMarketCap ---
  cmc_api_key           String?                   // chave da API do CoinMarketCap
  cmc_interval_min      Int?     @default(5)       // intervalo de coleta em minutos
  analysis_window_days  Int?     @default(1)       // janela de análise (1 a 5 dias)
  // --- Controle de execução ---
  enabled               Boolean  @default(false)  // só opera (compra/venda) quando ligado via /iniciar
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

// Histórico de preços coletados (fonte: CoinMarketCap).
// Base para o cálculo das 4 médias e da estratégia de reversão.
model priceHistory {
  id        String   @id @default(cuid())
  symbol    String
  price     Float
  source    String   @default("coinmarketcap")
  createdAt DateTime @default(now())

  @@index([symbol, createdAt])
}

// Estado da máquina de reversão, compartilhado entre reinícios.
// phase: IDLE | MONITOR_BUY (monitorando queda p/ comprar) | MONITOR_SELL (monitorando alta p/ vender)
model monitorState {
  id             String   @id @default(cuid())
  phase          String   @default("IDLE")
  extremePrice   Float?   // menor valor visto (compra) ou maior valor visto (venda)
  lastPrice      Float?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model ErrorNotification {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}